// Lagerist data model
// Note: SQLite has no native enum support in Prisma, so "kind"/"entityType"/
// custom field "type" are plain strings validated in application code
// (see src/lib/constants.ts for the allowed values).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  customFields Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Location[] @relation("LocationTree")

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("LocationPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  containers  Container[]
  attachments Attachment[]  @relation("LocationAttachments")
  tags        LocationTag[]

  @@index([parentId])
}

model Container {
  id          String   @id @default(cuid())
  name        String
  description String?
  customFields Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("ContainerPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  items       Item[]
  attachments Attachment[]   @relation("ContainerAttachments")
  tags        ContainerTag[]

  @@index([locationId])
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  quantity    Int      @default(1)
  customFields Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Exactly one of containerId / parentItemId is set:
  // top-level items live directly in a container, sub-items hang off a parent item.
  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)

  parentItemId String?
  parentItem   Item?  @relation("ItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems     Item[] @relation("ItemTree")

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("ItemPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  attachments Attachment[] @relation("ItemAttachments")
  tags        ItemTag[]

  @@index([containerId])
  @@index([parentItemId])
}

// entityType: "LOCATION" | "CONTAINER" | "ITEM"
// fields: JSON array of { key, label, type: "TEXT"|"NUMBER"|"DATE"|"BOOLEAN", defaultValue? }
model Template {
  id         String   @id @default(cuid())
  name       String
  entityType String
  fields     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  locations  Location[]
  containers Container[]
  items      Item[]
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?

  locationTags  LocationTag[]
  containerTags ContainerTag[]
  itemTags      ItemTag[]
}

model LocationTag {
  locationId String
  tagId      String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([locationId, tagId])
}

model ContainerTag {
  containerId String
  tagId       String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([containerId, tagId])
}

model ItemTag {
  itemId String
  tagId  String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

// kind: "PHOTO" | "FILE"
model Attachment {
  id         String   @id @default(cuid())
  kind       String
  filename   String
  storedPath String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  locationId String?
  location   Location? @relation("LocationAttachments", fields: [locationId], references: [id], onDelete: Cascade)

  containerId String?
  container   Container? @relation("ContainerAttachments", fields: [containerId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?  @relation("ItemAttachments", fields: [itemId], references: [id], onDelete: Cascade)

  locationPrimaryFor  Location?  @relation("LocationPrimaryPhoto")
  containerPrimaryFor Container? @relation("ContainerPrimaryPhoto")
  itemPrimaryFor      Item?      @relation("ItemPrimaryPhoto")

  @@index([locationId])
  @@index([containerId])
  @@index([itemId])
}
