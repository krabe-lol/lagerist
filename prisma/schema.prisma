// Lagerist data model
// Note: SQLite has no native enum support in Prisma, so "kind" is a plain
// string validated in application code (see src/lib/constants.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Set to false only for a draft row silently created when a "New Room"
  // page is opened (so attachment upload has a real id to target before the
  // form is actually submitted) — see roomActions.ts. Excluded from every
  // normal read via the confirmed-filtering Prisma client (see lib/db.ts).
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Location[] @relation("LocationTree")

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("LocationPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  containers  Container[]
  items       Item[]
  attachments Attachment[] @relation("LocationAttachments")

  @@index([parentId])
}

// Container "types" a user can pick when creating a Container (e.g. a specific
// storage-box product like "EzyStorage 18L"). Picking one prefills the
// Container's name plus its dimensions/volume, which stay editable afterwards.
model ContainerTemplate {
  id         String   @id @default(cuid())
  name       String
  dimensions String?
  volume     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  containers Container[]
}

model Container {
  id          String   @id @default(cuid())
  // System-assigned running number (see prepareNextContainerNumber in
  // src/lib/entities.ts) so that multiple containers sharing the same
  // templated name (e.g. several "EzyStorage 18L" boxes) stay distinguishable.
  number      Int      @unique
  name        String
  description String?
  dimensions  String?
  volume      String?
  // See Location.confirmed.
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Nullable so a draft Container (see `confirmed`) can exist before the
  // user has picked a Raum for it — every *confirmed* Container is expected
  // to always have one, enforced in application code (updateContainerAction),
  // not the DB schema.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  templateId String?
  template   ContainerTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("ContainerPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  items       Item[]
  attachments Attachment[] @relation("ContainerAttachments")

  @@index([locationId])
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  quantity    Int      @default(1)
  // See Location.confirmed.
  confirmed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Exactly one of locationId / containerId / parentItemId is set: an item
  // lives directly in a location, in a container, or as a sub-item of another item.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  containerId String?
  container   Container? @relation(fields: [containerId], references: [id], onDelete: Cascade)

  parentItemId String?
  parentItem   Item?  @relation("ItemTree", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems     Item[] @relation("ItemTree")

  primaryPhotoId String?     @unique
  primaryPhoto   Attachment? @relation("ItemPrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)

  attachments Attachment[] @relation("ItemAttachments")
  tags        ItemTag[]

  @@index([locationId])
  @@index([containerId])
  @@index([parentItemId])
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?

  itemTags ItemTag[]
}

model ItemTag {
  itemId String
  tagId  String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

// kind: "PHOTO" | "FILE"
model Attachment {
  id         String   @id @default(cuid())
  kind       String
  filename   String
  storedPath String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  locationId String?
  location   Location? @relation("LocationAttachments", fields: [locationId], references: [id], onDelete: Cascade)

  containerId String?
  container   Container? @relation("ContainerAttachments", fields: [containerId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?  @relation("ItemAttachments", fields: [itemId], references: [id], onDelete: Cascade)

  locationPrimaryFor  Location?  @relation("LocationPrimaryPhoto")
  containerPrimaryFor Container? @relation("ContainerPrimaryPhoto")
  itemPrimaryFor      Item?      @relation("ItemPrimaryPhoto")

  @@index([locationId])
  @@index([containerId])
  @@index([itemId])
}
